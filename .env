# Local development environment variables with mock fallbacks enabled
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=noida
PLATFORM_COMMISSION_PERCENT=15
ENABLE_MOCK_DRIVERS=true

# Supabase (Placeholders for local dev or connect to Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://mock-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key
SUPABASE_JWT_SECRET=mock-jwt-secret-at-least-32-chars-long

NEXT_PUBLIC_SUPABASE_STORAGE_AVATAR_BUCKET=avatars
NEXT_PUBLIC_SUPABASE_STORAGE_KYC_BUCKET=kyc-documents

# Database (Local Postgres or Supabase connection string)
DATABASE_URL="postgresql://loc_user:loc_password@localhost:5432/loc_connect_db?schema=public"
DIRECT_URL="postgresql://loc_user:loc_password@localhost:5432/loc_connect_db?schema=public"

# Razorpay Test Credentials (or mock)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_key_123456
RAZORPAY_KEY_ID=rzp_test_mock_key_123456
RAZORPAY_KEY_SECRET=mock_razorpay_secret_123456
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret_123456

# Google Maps (Placeholders for local dev)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=mock_google_maps_key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://mock.upstash.io
UPSTASH_REDIS_REST_TOKEN=mock_token

# Notifications
RESEND_API_KEY=mock_resend_key
RESEND_FROM_EMAIL=notifications@locconnect.test
MSG91_AUTH_KEY=mock_msg91_key
MSG91_SENDER_ID=LOCCON
MSG91_OTP_TEMPLATE_ID=mock_template
