# ==============================================================================
# LocConnect - Local Services Marketplace Environment Configuration
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=noida
PLATFORM_COMMISSION_PERCENT=15

# Enable local mock drivers when third-party API keys are not available
# (Allows running full auth, SMS OTP, Razorpay checkout, and notifications offline)
ENABLE_MOCK_DRIVERS=true

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Auth, Realtime, Storage)
# ------------------------------------------------------------------------------
# Get these from your Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key is used ONLY server-side for admin bypass and webhook verification
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-custom-claims

# Supabase Storage Buckets:
# - 'avatars' (public read)
# - 'kyc-documents' (private, restricted to provider & admin)
# - 'service-photos' (public read)
NEXT_PUBLIC_SUPABASE_STORAGE_AVATAR_BUCKET=avatars
NEXT_PUBLIC_SUPABASE_STORAGE_KYC_BUCKET=kyc-documents

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (PgBouncer - Port 6543)
DATABASE_URL="postgresql://postgres.[your-project-id]:[your-db-password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string for Prisma migrations (Direct connection - Port 5432)
DIRECT_URL="postgresql://postgres.[your-project-id]:[your-db-password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# For local development with Docker PostGIS (see docker-compose.yml):
# DATABASE_URL="postgresql://loc_user:loc_password@localhost:5432/loc_connect_db?schema=public"
# DIRECT_URL="postgresql://loc_user:loc_password@localhost:5432/loc_connect_db?schema=public"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Test keys from Razorpay Dashboard -> Settings -> API Keys (rzp_test_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
# Webhook secret configured in Razorpay Webhook settings for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretSigningKeyHere

# ------------------------------------------------------------------------------
# 5. MAPS & GEOCODING (Google Maps Platform)
# ------------------------------------------------------------------------------
# Enable: Places API, Geocoding API, Distance Matrix API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ------------------------------------------------------------------------------
# 6. CACHING & RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Upstash Redis REST credentials (or fallback to local in-memory store in dev)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS (SMS & Email)
# ------------------------------------------------------------------------------
# Resend API Key for transactional emails (booking confirmations, status updates)
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM_EMAIL=LocConnect <notifications@yourdomain.com>

# SMS OTP Provider (MSG91 or Twilio)
# MSG91:
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=LOCCON
MSG91_OTP_TEMPLATE_ID=your_msg91_template_id

# Or Twilio (Alternative):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
